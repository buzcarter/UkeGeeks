{
  "name": "ukegeeks-scriptasaurus",
  "version": "1.4.4",
  "description": "UkeGeeks Scriptasaurus: ChordPro songbook with ukulele chord diagrams, served by a small Node.js server",
  "private": true,
  "license": "GPL-3.0",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
